# Backend origin for browser requests (`src/lib/api.ts`).
# Unset → http://localhost:8000 (local dev).
#
# On Vercel this is a BUILD-TIME value: Next inlines it into the client bundle,
# so changing it requires a redeploy. No trailing slash — `${API_URL}/api/…`
# would otherwise produce a double slash, and the Render CORS rule is an exact
# origin match.
NEXT_PUBLIC_API_URL=https://your-service.onrender.com
